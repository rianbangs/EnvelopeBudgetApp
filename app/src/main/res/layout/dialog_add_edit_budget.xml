<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/editTextDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Budget Name"
        android:inputType="text" />

    <EditText
        android:id="@+id/editTextDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Date (yyyy-mm-dd)"

        android:inputType="none"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clickable="true"

        android:layout_marginTop="8dp" />

<!--    android:inputType="none"  &lt;!&ndash; Disables the soft keyboard &ndash;&gt;-->
<!--    android:focusable="false" &lt;!&ndash; Prevents the EditText from gaining focus &ndash;&gt;-->
<!--    android:focusableInTouchMode="false" &lt;!&ndash; Prevents the EditText from gaining focus in touch mode &ndash;&gt;-->
<!--    android:clickable="true" &lt;!&ndash; Allows the EditText to still respond to clicks &ndash;&gt;-->

</LinearLayout>
